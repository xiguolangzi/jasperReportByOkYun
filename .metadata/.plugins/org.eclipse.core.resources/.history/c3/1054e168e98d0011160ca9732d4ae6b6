<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="payTable" 
              language="java"
              pageWidth="204" 
              pageHeight="30" 
              columnCount="1"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">
    
    <!-- 属性 -->
    <property name="net.sf.jasperreports.default.font.name" value="阿里巴巴普惠体"/>
    <property name="net.sf.jasperreports.default.pdf.font.name" value="阿里巴巴普惠体"/>
    <property name="net.sf.jasperreports.default.pdf.encoding" value="Identity-H"/>
    <property name="net.sf.jasperreports.print.keep.full.text" value="true"/>
    <property name="net.sf.jasperreports.export.pdf.force.linebreak.policy" value="true"/>
    
    <!-- 导入 - JasperReports 7.0 使用 value 属性 -->
    <import value="java.math.BigDecimal"/>
    
    <!-- 字段定义 -->
    <field name="payMethod" class="java.lang.String"/>
    <field name="transactionNo" class="java.lang.String"/>
    <field name="payAmount" class="java.math.BigDecimal"/>
    
    <!-- 数据行 -->
    <detail>
        <band height="15">
            <element kind="textField" x="0" y="0" width="60" height="15" 
                     fontName="阿里巴巴普惠体" 
                     fontSize="8.0" 
                     bold="true" 
                     hTextAlign="Left" 
                     vTextAlign="Middle">
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <expression><![CDATA[$F{payMethod}]]></expression>
            </element>
            
            <element kind="textField" x="60" y="0" width="80" height="15" 
                     fontName="阿里巴巴普惠体" 
                     fontSize="8.0" 
                     bold="true" 
                     hTextAlign="Center" 
                     vTextAlign="Middle">
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <printWhenExpression><![CDATA[$F{transactionNo} != null]]></printWhenExpression>
                <expression><![CDATA[$F{transactionNo}]]></expression>
            </element>
            
            <element kind="textField" x="140" y="0" width="60" height="15" 
                     fontName="阿里巴巴普惠体" 
                     fontSize="8.0" 
                     pattern="#,##0.##" 
                     bold="true" 
                     hTextAlign="Right" 
                     vTextAlign="Middle">
                <box>
                    <pen lineWidth="0.5" lineColor="#000000"/>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <expression><![CDATA[$F{payAmount} + " €"]]></expression>
            </element>
        </band>
    </detail>
</jasperReport>