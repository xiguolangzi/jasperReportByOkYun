<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="payTable" 
              pageWidth="204" 
              pageHeight="30" 
              columnCount="1"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">
    
    <property name="net.sf.jasperreports.default.font.name" value="阿里巴巴普惠体"/>
    <property name="net.sf.jasperreports.default.pdf.font.name" value="阿里巴巴普惠体"/>
    <property name="net.sf.jasperreports.default.pdf.encoding" value="Identity-H"/>
    <property name="net.sf.jasperreports.print.keep.full.text" value="true"/>
    
    <import value="java.math.BigDecimal"/>
    
    <field name="payMethod" class="java.lang.String"/>
    <field name="transactionNo" class="java.lang.String"/>
    <field name="payAmount" class="java.math.BigDecimal"/>
    
    <detail>
        <band height="15">
            <textField>
                <reportElement x="0" y="0" width="60" height="15"/>
                <box>
                    <pen lineWidth="0.5"/>
                    <topPen lineWidth="0.5"/>
                    <leftPen lineWidth="0.5"/>
                    <bottomPen lineWidth="0.5"/>
                    <rightPen lineWidth="0.5"/>
                </box>
                <textElement fontName="阿里巴巴普惠体" fontSize="8" bold="true" textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{payMethod}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="60" y="0" width="80" height="15"/>
                <box>
                    <pen lineWidth="0.5"/>
                    <topPen lineWidth="0.5"/>
                    <leftPen lineWidth="0.5"/>
                    <bottomPen lineWidth="0.5"/>
                    <rightPen lineWidth="0.5"/>
                </box>
                <textElement fontName="阿里巴巴普惠体" fontSize="8" bold="true" textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{transactionNo}]]></textFieldExpression>
                <printWhenExpression><![CDATA[$F{transactionNo} != null]]></printWhenExpression>
            </textField>
            
            <textField>
                <reportElement x="140" y="0" width="60" height="15"/>
                <box>
                    <pen lineWidth="0.5"/>
                    <topPen lineWidth="0.5"/>
                    <leftPen lineWidth="0.5"/>
                    <bottomPen lineWidth="0.5"/>
                    <rightPen lineWidth="0.5"/>
                </box>
                <textElement fontName="阿里巴巴普惠体" fontSize="8" pattern="#,##0.##" bold="true" textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{payAmount} + " €"]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>